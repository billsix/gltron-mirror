#define PREFIX "@prefix@"              /* /usr/local */
#define EXEC_PREFIX "@exec_prefix@"    /* ${prefix} */
#define BINDIR "@bindir@"              /* ${exec_prefix}/bin */
#define SBINDIR "@sbindir@"            /* ${exec_prefix}/sbin */
#define LIBEXECDIR "@libexecdir@"      /* ${exec_prefix}/libexec */
#define DATAROOTDIR "@datarootdir@"    /* ${prefix}/share */
#define DATADIR "@datadir@"            /* ${datarootdir} */
#define SYSCONFDIR "@sysconfdir@"      /* ${prefix}/etc */
#define SHAREDSTATEDIR "@sharedstatedir@" /* ${prefix}/com */
#define LOCALSTATEDIR "@localstatedir@"   /* ${prefix}/var */
#define RUNSTATEDIR "@runstatedir@"    /* ${localstatedir}/run */
#define INCLUDEDIR "@includedir@"      /* ${prefix}/include */
#define OLDINCLUDEDIR "@oldincludedir@" /* /usr/include */
#define DOCDIR "@docdir@"              /* ${datarootdir}/doc/${PACKAGE} */
#define INFODIR "@infodir@"            /* ${datarootdir}/info */
#define HTMLDIR "@htmldir@"            /* ${docdir} */
#define DVIDIR "@dvidir@"              /* ${docdir} */
#define PDFDIR "@pdfdir@"              /* ${docdir} */
#define PSDIR "@psdir@"                /* ${docdir} */
#define LIBDIR "@libdir@"              /* ${exec_prefix}/lib */
#define LOCALEDIR "@localedir@"        /* ${datarootdir}/locale */
#define MANDIR "@mandir@"              /* ${datarootdir}/man */
